extends ../layouts/default.pug

block title
  title Đổi mật khẩu

block main
  .box-title Đổi mật khẩu

  //- Section 7
  .section-7
    form.inner-form(id="profileChangePasswordForm")
      .inner-group
        label(for="password", class="inner-label") Mật khẩu mới
        input(type="password", name="password", class="inner-control", id="password")
      .inner-group
        label(for="confirmPassword", class="inner-label") Nhập lại mật khẩu mới
        input(type="password", name="confirmPassword", class="inner-control", id="confirmPassword")
      .inner-two-col.inner-button
        button Đổi mật khẩu
    a.inner-back(href="#") Thông tin cá nhân
  //- End Section 7
