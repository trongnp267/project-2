extends ../layouts/default.pug

block title
  title Thông tin website

block main
  .box-title Thông tin website

  //- Section 7
  .section-7
    form.inner-form(id="settingWebsiteInfoForm")
      .inner-group
        label(for="websiteName", class="inner-label") Tên website 
        input(type="text", name="websiteName", class="inner-control", id="websiteName")
      .inner-group
        label(for="phone", class="inner-label") Số điện thoại 
        input(type="number", name="phone", class="inner-control", id="phone")
      .inner-group
        label(for="email", class="inner-label") Email 
        input(type="email", name="email", class="inner-control", id="email")
      .inner-group
        label(for="address", class="inner-label") Địa chỉ
        input(type="text", name="address", class="inner-control", id="address")
      .inner-group
        label(for="logo", class="inner-label") Logo
        input(type="file", name="logo", class="inner-control inner-input-file", filepond-image, id="logo")
      .inner-group
        label(for="favicon", class="inner-label") Favicon
        input(type="file", name="favicon", class="inner-control inner-input-file", filepond-image, id="favicon")
      .inner-two-col.inner-button
        button Cập nhật
    a.inner-back(href="#") Quay lại danh sách
  //- End Section 7
