extends ../layouts/default.pug

block title
  title Đơn hàng: OD000001

block main
  .box-title Đơn hàng: OD000001

  //- Section 7
  .section-7
    form.inner-form(id="orderEditForm")
      .inner-group
        label(for="fullName", class="inner-label") Tên khách hàng *
        input(type="text", name="fullName", class="inner-control", id="fullName")
      .inner-group
        label(for="phone", class="inner-label") Số điện thoại *
        input(type="number", name="phone", class="inner-control", id="phone")
      .inner-group.inner-two-col
        label(for="note", class="inner-label") Ghi chú
        textarea(name="note", class="inner-control", id="note")
      .inner-group
        label(for="paymentMethod", class="inner-label") Phương thức thanh toán
        select(name="paymentMethod", class="inner-control", id="paymentMethod")
          option(value="momo") Ví Momo
          option(value="zalopay") Zala Pay
          option(value="bank") Bank
      .inner-group
        label(for="paymentStatus", class="inner-label") Trạng thái thanh toán
        select(name="paymentStatus", class="inner-control", id="paymentStatus")
          option(value="paid") Đã thanh toán
          option(value="unpaid") Chưa thanh toán
      .inner-group
        label(for="", class="inner-label") Ngày đặt
        input(type="text", name="", class="inner-control", readonly, value="17/05/2026")
      .inner-group
        label(for="status", class="inner-label") Trạng thái
        select(name="status", class="inner-control", id="status")
          option(value="initial") Khởi tạo
          option(value="uninitial") Chưa khởi tạo
      .inner-group
        label(for="", class="inner-label") Danh sách tour
        .inner-tour-list
          .inner-item
            img(src="assets/images/tour-1.png", alt="")
            .inner-content
              .inner-tour-name Tour Hạ Long
              .inner-tour-detail
                div Người lớn: 3 x 1.500.000đ
                div Trẻ em: 2 x 1.300.000đ
                div Em bé: 2 x 1.000.000đ
                div Ngày khởi hành: 20/10/2024
                div Khởi hành tại: Hà Nội
          .inner-item
            img(src="assets/images/tour-1.png", alt="")
            .inner-content
              .inner-tour-name Tour Hạ Long
              .inner-tour-detail
                div Người lớn: 3 x 1.500.000đ
                div Trẻ em: 2 x 1.300.000đ
                div Em bé: 2 x 1.000.000đ
                div Ngày khởi hành: 20/10/2024
                div Khởi hành tại: Hà Nội
      .inner-group
        label(for="", class="inner-label") Thanh toán
        .inner-price
          div Tổng tiền: 10.000.000đ
          div Giảm: 400.000đ
          div Mã giảm: TOURMUAHE2024
          div
            | Thanh toán: 
            span.inner-price-hl 9.600.000đ
      .inner-two-col.inner-button
        button Cập nhật
    a.inner-back(href="#") Quay lại danh sách
  //- End Section 7
